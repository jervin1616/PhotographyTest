---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Img from '../components/Img.astro';
import CtaBand from '../components/CtaBand.astro';
import portfolio from '../data/portfolio.json';
import { imgInfo, categoryLabel } from '../lib/images';

const items = (portfolio as any[]).map((p) => imgInfo(`portfolio/${p.id}`));
const count = (c: string) => items.filter((i) => i.category === c).length;
const cats = [['all', 'All', items.length], ['weddings', 'Weddings', count('weddings')], ['portraits', 'Portraits', count('portraits')], ['landscapes', 'Landscapes', count('landscapes')]] as const;
---
<Base title="Portfolio" description="Weddings, portraits and coastal landscapes by Saltmarsh Photo Co. Browse the portfolio and open any photo full size.">
  <PageHero image="portfolio/landscapes-02" kicker="Selected work" title="The Portfolio" subtitle="Weddings on the shoreline, portraits in the dunes and landscapes at the edges of the day. Choose a photo to see it full size." position="center 60%" />

  <section class="container-x pb-8" data-filter-group>
    <div class="flex flex-wrap items-center justify-between gap-5 border-b border-line pb-6">
      <div class="flex flex-wrap gap-2" role="group" aria-label="Filter portfolio">
        {cats.map(([key, label, n]) => (
          <button type="button" class="chip" data-filter={key} aria-pressed={key === 'all' ? 'true' : 'false'}>{label}<small>{n}</small></button>
        ))}
      </div>
      <p class="hidden text-xs tracking-[.14em] text-mist uppercase sm:block">Use ← → to browse once a photo is open</p>
    </div>

    <ul class="masonry mt-8" data-lightbox-group>
      {items.map((p, i) => (
        <li data-cat={p.category}>
          <a class="tile reveal-img" style={`--d:${(i % 3) * 90}ms`} href={p.src(1800)} data-lightbox data-cursor="View"
            data-title={p.title} data-alt={p.alt} data-credit={p.photographer} data-credit-url={p.photographerUrl}>
            <Img id={p.ref} sizes="(min-width:820px) 33vw, 50vw" class="!h-auto w-full" loading={i < 4 ? 'eager' : 'lazy'} />
            <span class="cap">
              <span class="cap-eyebrow">{categoryLabel[p.category!]}</span>
              <span class="cap-title">{p.title}</span>
              <span class="cap-credit">Photo by {p.photographer} · Unsplash</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
    <p data-empty hidden class="py-24 text-center text-mist">Nothing here yet.</p>
  </section>

  <section class="container-x py-20 text-center">
    <div class="rule mx-auto max-w-xl"></div>
    <p class="kicker mt-10 reveal">Looking for your own photographs?</p>
    <p class="lead mx-auto mt-4 max-w-xl reveal" style="--d:100ms">Clients receive a private, passworded gallery for their session. Proofs are watermarked until you choose your favourites.</p>
    <a class="btn btn-ghost mt-8 reveal" style="--d:200ms" href="/client-login/">Visit client login <span class="arr" aria-hidden="true">→</span></a>
  </section>

  <CtaBand />
</Base>
