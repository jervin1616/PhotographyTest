{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "saltmarsh-photo-co",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",

  "assets": {
    // The PUBLIC site only. Client galleries are never in here (see scripts/build.mjs, which checks).
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Run the Worker BEFORE any asset lookup for everything under /clients/.
    "run_worker_first": ["/clients/*"]
  },

  // The private bucket holding gallery pages + watermarked proofs. No public access, no custom
  // domain, no r2.dev URL: the only door is this Worker.
  "r2_buckets": [{ "binding": "CLIENTS", "bucket_name": "saltmarsh-clients" }],

  // Per-IP password-attempt limit: 5 attempts per 60 seconds, per Cloudflare location.
  "ratelimits": [
    { "name": "LOGIN_LIMITER", "namespace_id": "4101", "simple": { "limit": 5, "period": 60 } }
  ],

  "observability": { "enabled": true }
}
