---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import owner from '../data/owner.json';
// ONE place to change the form endpoint. While it still contains REPLACE_WITH_YOUR_FORM_ID the form runs in demo mode:
// it validates and shows the success screen, but sends nothing. See README ("Contact form").
const FORM_ENDPOINT = 'https://formspree.io/f/REPLACE_WITH_YOUR_FORM_ID';
const types = ['Wedding', 'Portrait', 'Landscape / prints', 'Something else'];
const faqs = [
  ['Do you offer free consultations?', 'Always. A relaxed 20-minute call, no pressure and no sales script.'],
  ['Can we meet before booking?', 'Of course. We often meet clients at the beach for coffee and a walk-through of the light.'],
  ['What should we include in our message?', 'The date or season, the place (or your wish list of places), a rough guest count, and the feeling you are after.'],
];
---
<Base title="Contact" description="Book a coastal wedding, portrait or print session with Saltmarsh Photo Co. Meet Elena Marsh, our founder, and tell us about your day.">
  <PageHero image="site/contact-hero" small kicker="Let's talk" title="Say hello" subtitle="Tell us about your day. We reply within one working day, usually with a very long list of questions." position="center 45%" />

  <section class="container-x grid items-start gap-10 pb-24 lg:grid-cols-[.8fr_1.2fr] lg:gap-14 lg:pb-32">
    <!-- details -->
    <aside class="space-y-5 lg:sticky lg:top-28">
      <div class="panel p-7 reveal">
        <p class="label">Studio</p>
        <ul class="mt-5 space-y-5 text-[.95rem]">
          <li class="flex gap-4"><svg class="mt-1 shrink-0 text-seaglass" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="1.5"/><path d="m3.5 6.5 8.5 6.5 8.5-6.5"/></svg><a class="link-u" href="mailto:hello@saltmarsh.example">hello@saltmarsh.example</a></li>
          <li class="flex gap-4"><svg class="mt-1 shrink-0 text-seaglass" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a1 1 0 0 1-1 1A16 16 0 0 1 4 5a1 1 0 0 1 1-1Z"/></svg><span>(910) 555-0142</span></li>
          <li class="flex gap-4"><svg class="mt-1 shrink-0 text-seaglass" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21Z"/><circle cx="12" cy="9.5" r="2.4"/></svg><span>The loft above the sailmaker's<br /><span class="text-mist">Serving the Carolina coast and beyond</span></span></li>
          <li class="flex gap-4"><svg class="mt-1 shrink-0 text-seaglass" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><circle cx="12" cy="12" r="8.5"/><path d="M12 7v5l3 2"/></svg><span>Mon–Fri, 9–5<br /><span class="text-mist">Sessions at sunrise and sunset, naturally</span></span></li>
        </ul>
      </div>
      <div class="panel p-7 reveal" style="--d:100ms">
        <p class="label">What happens next</p>
        <ol class="mt-5 space-y-4 text-[.95rem] text-mist">
          <li><span class="font-script text-2xl text-sun">1</span> We reply within one working day.</li>
          <li><span class="font-script text-2xl text-sun">2</span> A relaxed intro call or coffee.</li>
          <li><span class="font-script text-2xl text-sun">3</span> A proposal and a date held for you.</li>
        </ol>
      </div>
    </aside>

    <!-- form -->
    <div class="panel relative overflow-hidden p-7 sm:p-10 reveal" style="--d:60ms">
      <div id="form-wrap">
        <h2 class="text-4xl sm:text-5xl">Start the conversation</h2>
        <p class="mt-3 text-sm text-mist" role="note">Demo mode: this form validates and shows a confirmation, but nothing you type is stored or sent to a person.</p>
        <form id="contact-form" method="post" action={FORM_ENDPOINT} novalidate class="mt-8 space-y-7">
          <div class="grid gap-7 sm:grid-cols-2">
            <div class="field"><label for="name">Your name</label><input class="input" id="name" name="name" type="text" required autocomplete="name" minlength="2" /><p class="err mt-1 text-sm text-red-300" data-for="name" hidden></p></div>
            <div class="field"><label for="email">Email</label><input class="input" id="email" name="email" type="email" required autocomplete="email" /><p class="err mt-1 text-sm text-red-300" data-for="email" hidden></p></div>
          </div>
          <fieldset class="field">
            <legend>What are you planning?</legend>
            <div class="flex flex-wrap gap-2">
              {types.map((t) => <label class="pill relative"><input type="radio" name="session" value={t} /><span>{t}</span></label>)}
            </div>
            <p class="err mt-1 text-sm text-red-300" data-for="session" hidden></p>
          </fieldset>
          <div class="grid gap-7 sm:grid-cols-2">
            <div class="field"><label for="date">Preferred date or season <span class="normal-case tracking-normal text-mist/70">(optional)</span></label><input class="input" id="date" name="date" type="text" placeholder="e.g. October, or 12 Sept 2027" /></div>
            <div class="field"><label for="place">Place in mind <span class="normal-case tracking-normal text-mist/70">(optional)</span></label><input class="input" id="place" name="place" type="text" placeholder="A beach, a pier, no idea yet…" /></div>
          </div>
          <div class="field"><label for="message">Tell us about it</label><textarea class="input" id="message" name="message" rows="5" required minlength="10" placeholder="The feeling you are after, the people involved, anything that makes it yours…"></textarea><p class="err mt-1 text-sm text-red-300" data-for="message" hidden></p></div>
          <div aria-hidden="true" style="position:absolute;left:-9999px;top:auto;width:1px;height:1px;overflow:hidden"><label>Leave this empty <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label></div>
          <button type="submit" class="btn btn-primary w-full sm:w-auto">Send message <span class="arr" aria-hidden="true">→</span></button>
          <p id="status" role="status" class="text-sm text-mist"></p>
        </form>
      </div>
      <div id="sent" hidden class="py-10 text-center">
        <svg class="check-draw mx-auto text-seaglass" width="84" height="84" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="24" cy="24" r="21"/><path d="M14 25l7 7 13-15" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <p class="mt-4 font-script text-6xl leading-none">Thank you<span id="sent-name"></span>!</p>
        <p class="lead mx-auto mt-4 max-w-md" id="sent-msg">Your message is on its way. We reply within one working day.</p>
        <button type="button" class="btn btn-ghost mt-8" id="again">Send another</button>
      </div>
    </div>
  </section>

  <!-- ============ MEET THE OWNER ============ -->
  <section id="elena" class="border-y border-line bg-black/20 py-24 lg:py-32">
    <div class="container-x">
      <div class="grid items-start gap-14 lg:grid-cols-[.85fr_1.15fr] lg:gap-20">
        <div class="lg:sticky lg:top-28">
          <p class="kicker reveal">Meet the founder</p>
          <div class="relative mx-auto mt-6 w-full max-w-[22rem] reveal" style="--d:100ms">
            <svg viewBox="0 0 200 200" class="w-full" role="img" aria-label="Saltmarsh Photo Co. seal, established 2016">
              <defs><path id="ring" d="M100,100 m-80,0 a80,80 0 1,1 160,0 a80,80 0 1,1 -160,0" /></defs>
              <circle cx="100" cy="100" r="97" fill="none" stroke="#3b5064" stroke-width=".6" />
              <circle cx="100" cy="100" r="62" fill="#142231" stroke="#e3b07e" stroke-width=".8" />
              <g class="spin-slow" style="transform-origin:100px 100px">
                <text font-family="Inter, sans-serif" font-size="9.4" fill="#a9b4bb"><textPath href="#ring" textLength="497" lengthAdjust="spacing">SALTMARSH PHOTO CO. · EST. 2016 · CAROLINA COAST · TIDE &amp; LIGHT · </textPath></text>
              </g>
              <text x="100" y="116" text-anchor="middle" font-family="Great Vibes, cursive" font-size="58" fill="#ece4d6">{owner.monogram}</text>
            </svg>
          </div>
          <p class="mt-8 text-center font-script text-6xl leading-none text-paper reveal" style="--d:200ms">{owner.name}</p>
          <p class="mt-2 text-center text-xs tracking-[.24em] text-seaglass uppercase reveal" style="--d:250ms">{owner.role}</p>
          <figure class="mx-auto mt-8 max-w-xs text-center reveal" style="--d:300ms">
            <blockquote class="font-serif text-2xl italic leading-snug text-paper/90">“{owner.quote}”</blockquote>
          </figure>
        </div>

        <div>
          <p class="font-serif text-3xl leading-snug text-paper sm:text-4xl reveal">{owner.intro}</p>
          <div class="mt-8 space-y-5 text-lg leading-relaxed text-mist">
            {owner.story.map((p, i) => <p class="reveal" style={`--d:${i * 80}ms`}>{p}</p>)}
          </div>

          <h3 class="mt-14 text-3xl reveal">The long way round</h3>
          <ol class="relative mt-6 space-y-6 border-l border-line2 pl-8">
            {owner.timeline.map(([year, text], i) => (
              <li class="relative reveal" style={`--d:${i * 70}ms`}>
                <span class="absolute -left-[2.45rem] top-2 h-2.5 w-2.5 rounded-full bg-sun ring-4 ring-ink"></span>
                <p class="font-script text-3xl leading-none text-sun">{year}</p>
                <p class="mt-1 text-mist">{text}</p>
              </li>
            ))}
          </ol>

          <h3 class="mt-14 text-3xl reveal">A few small things</h3>
          <dl class="mt-6 grid gap-px overflow-hidden border border-line bg-line sm:grid-cols-2">
            {owner.facts.map(([k, v], i) => (
              <div class="bg-ink p-5 reveal" style={`--d:${i * 70}ms`}>
                <dt class="label">{k}</dt>
                <dd class="mt-2 font-serif text-2xl leading-snug">{v}</dd>
              </div>
            ))}
          </dl>

          <div class="panel mt-14 p-7 sm:p-9 reveal">
            <p class="kicker">Before your session</p>
            <p class="mt-3 text-lg leading-relaxed text-mist">{owner.beforeSession}</p>
            <p class="mt-5 text-sm text-mist/80">— Elena</p>
          </div>
          <p class="mt-6 text-xs text-mist/70">Elena Marsh and Saltmarsh Photo Co. are fictional, created for this demo.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="container-x py-24 lg:py-28">
    <div class="grid gap-12 lg:grid-cols-[.8fr_1.4fr]">
      <div><p class="kicker reveal">Before you write</p><h2 class="h-section mt-2 reveal" style="--d:80ms">Quick answers</h2>
        <p class="lead mt-5 reveal" style="--d:160ms">More in our <a class="link-u text-paper" href="/services/#faq">full FAQ</a>.</p></div>
      <div class="faq reveal">{faqs.map(([q, a], i) => <details open={i === 0}><summary>{q}</summary><div>{a}</div></details>)}</div>
    </div>
  </section>

  <script is:inline define:vars={{ endpoint: FORM_ENDPOINT }}>
    (function () {
      var form = document.getElementById('contact-form'); if (!form) return;
      var status = document.getElementById('status'), wrap = document.getElementById('form-wrap'), sent = document.getElementById('sent');
      var demo = endpoint.indexOf('REPLACE_WITH_YOUR_FORM_ID') !== -1;
      // preselect the session type from ?type=Wedding (links from the Services page)
      var want = new URLSearchParams(location.search).get('type');
      var radios = form.querySelectorAll('input[name="session"]'), picked = false;
      radios.forEach(function (r) { if (want && r.value.toLowerCase().indexOf(want.toLowerCase()) === 0) { r.checked = true; picked = true; } });
      if (!picked && radios[0]) radios[0].checked = true;
      function err(name, msg) { var p = form.querySelector('.err[data-for="' + name + '"]'); if (p) { p.textContent = msg || ''; p.hidden = !msg; } }
      function validate() {
        var ok = true, v = function (n) { return (form.elements[n].value || '').trim(); };
        if (v('name').length < 2) { err('name', 'Please tell us your name.'); ok = false; } else err('name');
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v('email'))) { err('email', 'Please enter a valid email address.'); ok = false; } else err('email');
        if (!form.querySelector('input[name="session"]:checked')) { err('session', 'Please choose one.'); ok = false; } else err('session');
        if (v('message').length < 10) { err('message', 'A sentence or two will do.'); ok = false; } else err('message');
        return ok;
      }
      function done(name, real) {
        document.getElementById('sent-name').textContent = name ? ', ' + name.split(' ')[0] : '';
        document.getElementById('sent-msg').textContent = real ? 'Your message is on its way. We reply within one working day.' : 'This is a demo, so nothing was actually sent. Once a real form endpoint is connected, this is where your message would arrive.';
        wrap.hidden = true; sent.hidden = false; sent.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
      form.addEventListener('submit', function (e) {
        e.preventDefault(); status.textContent = '';
        if (!validate()) { var first = form.querySelector('.err:not([hidden])'); if (first) first.scrollIntoView({ behavior: 'smooth', block: 'center' }); return; }
        var name = form.elements['name'].value.trim();
        if (form.elements['_gotcha'].value) { done(name, true); return; }            // bot: pretend success, send nothing
        if (demo) { done(name, false); return; }
        status.textContent = 'Sending…';
        fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } })
          .then(function (r) { if (!r.ok) throw new Error(); done(name, true); form.reset(); })
          .catch(function () { status.textContent = 'Sorry, that did not send. Please email hello@saltmarsh.example instead.'; });
      });
      document.getElementById('again').addEventListener('click', function () { form.reset(); sent.hidden = true; wrap.hidden = false; });
    })();
  </script>
</Base>
