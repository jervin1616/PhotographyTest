---
import Base from '../layouts/Base.astro';
// DEMO ONLY: these passwords are deliberately public so visitors can try the demo.
// The deployed data files and Worker only ever contain salted PBKDF2 hashes.
const demos = [
  { slug: 'smith-wedding', title: 'The Smith Wedding', password: 'driftwood-tide-42' },
  { slug: 'coastal-portraits', title: 'Coastal Portraits', password: 'seaglass-dune-87' },
];
---
<Base title="Client Login" description="How private client galleries work at Saltmarsh Photo Co.">
  <section class="mx-auto max-w-3xl px-5 pt-14">
    <h1 class="text-4xl sm:text-5xl">Client login</h1>
    <p class="mt-4 text-lg text-driftwood-dark leading-relaxed">
      After your session, we create a private gallery just for you. Open the link we email you and enter your password.
      Galleries are never listed publicly and are hidden from search engines.
    </p>

    <h2 class="mt-12 text-2xl">How it works</h2>
    <ol class="mt-4 space-y-3 list-decimal pl-5 text-driftwood-dark leading-relaxed">
      <li>You receive a link like <code class="bg-sand-deep px-1">/clients/your-name</code> and a password.</li>
      <li>The gallery page and every photo in it are kept in private storage. They are only handed out after the password is checked.</li>
      <li>Photos in the gallery carry a <strong>PROOF</strong> watermark. Final, unmarked files are delivered separately.</li>
      <li>Each gallery has its own password. One gallery's password does not open another.</li>
    </ol>

    <h2 class="mt-12 text-2xl">Try the demo galleries</h2>
    <p class="mt-3 text-sm bg-sand-deep px-4 py-3 text-driftwood-dark">
      Demo only: these passwords are shown here so you can try the site. Real client passwords would never be published.
    </p>
    <ul class="mt-6 grid gap-4 sm:grid-cols-2">
      {demos.map((d) => (
        <li class="border border-driftwood/40 bg-white/60 p-5">
          <h3 class="text-xl">{d.title}</h3>
          <dl class="mt-3 text-sm space-y-1">
            <div class="flex gap-2"><dt class="text-driftwood-dark">Link</dt><dd><a class="underline" href={`/clients/${d.slug}`}>/clients/{d.slug}</a></dd></div>
            <div class="flex gap-2"><dt class="text-driftwood-dark">Password</dt><dd><code class="bg-sand-deep px-1">{d.password}</code></dd></div>
          </dl>
        </li>
      ))}
    </ul>
  </section>
  <div class="h-8"></div>
</Base>
