---
// ONE shared gallery. Size names -> CSS grid spans. Adding a client needs no new code.
//   hero  : full width            (12 cols x 14 rows)
//   wide  : two-thirds width      ( 8 cols x 12 rows)
//   half  : half width            ( 6 cols x  8 rows)
//   third : one third width       ( 4 cols x  6 rows)
//   tall  : one third, two rows   ( 4 cols x 12 rows)  = two thirds stacked
// Row groups that tile exactly: hero | wide+tall | tall*3 | half*2 | third*3
export type GallerySize = 'hero' | 'wide' | 'half' | 'third' | 'tall';
interface Props { slug: string; images: { file: string; size: GallerySize }[]; }
const { slug, images } = Astro.props;
const base = `/clients/${slug}/img/`;
const thumb = (f: string) => base + f.replace(/\.jpg$/i, '-600.jpg');
const full = (f: string) => base + f;
const sizesAttr: Record<GallerySize, string> = {
  hero: '100vw', wide: '(min-width:640px) 66vw, 100vw', half: '(min-width:640px) 50vw, 100vw',
  third: '(min-width:640px) 33vw, 50vw', tall: '(min-width:640px) 33vw, 50vw',
};
---
<ul class="gallery" role="list" data-lightbox-group>
  {images.map((img, i) => (
    <li class={`g-item g-${img.size} reveal`}>
      <a class="tile" href={full(img.file)} target="_blank" rel="noopener" data-lightbox data-cursor="View" data-title={`Proof ${i + 1} of ${images.length}`} data-alt={`Proof ${i + 1}`} aria-label={`Open proof ${i + 1} full size`}>
        <img src={thumb(img.file)} srcset={`${thumb(img.file)} 600w, ${full(img.file)} 1800w`} sizes={sizesAttr[img.size]}
          alt={`Proof ${i + 1}`} loading={i < 2 ? 'eager' : 'lazy'} decoding="async"
          width={img.size === 'tall' ? 400 : 600} height={img.size === 'tall' ? 600 : img.size === 'hero' ? 300 : 400} />
      </a>
    </li>
  ))}
</ul>

<style is:global>
  .gallery {
    --gap: .5rem;
    --cols: 12;
    --pad: 1.25rem;
    --col: calc((min(100vw, 76rem) - 2 * var(--pad) - (var(--cols) - 1) * var(--gap)) / var(--cols));
    list-style: none; margin: 0 auto; padding: 0 var(--pad); max-width: 76rem;
    display: grid; grid-template-columns: repeat(var(--cols), 1fr);
    grid-auto-rows: calc(var(--col) * .5); gap: var(--gap); grid-auto-flow: dense;
  }
  .gallery .g-item { overflow: hidden; background: #142231; }
  .gallery .g-item a, .gallery .g-item img { display: block; width: 100%; height: 100%; }
  .gallery .g-item img { object-fit: cover; }
  .g-hero  { grid-column: span 12; grid-row: span 14; }
  .g-wide  { grid-column: span 8;  grid-row: span 12; }
  .g-half  { grid-column: span 6;  grid-row: span 8; }
  .g-third { grid-column: span 4;  grid-row: span 6; }
  .g-tall  { grid-column: span 4;  grid-row: span 12; }
  @media (min-width: 640px) { .gallery { --pad: 2rem; } }
  /* phones: 6 columns, same size names */
  @media (max-width: 639px) {
    .gallery { --cols: 6; --col: calc((100vw - 2 * var(--pad) - 5 * var(--gap)) / 6); }
    .g-hero, .g-wide, .g-half { grid-column: span 6; grid-row: span 8; }
    .g-third { grid-column: span 3; grid-row: span 6; }
    .g-tall  { grid-column: span 3; grid-row: span 12; }
  }
</style>
