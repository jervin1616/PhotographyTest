---
// PRIVATE PAGE. Built only by `npm run build:private` (PRIVATE_BUILD=1) into private-dist/,
// never into the public dist/ that Cloudflare serves as static assets.
import Base from '../../layouts/Base.astro';
import Gallery from '../../components/Gallery.astro';
import events from '../../data/events.json';

export function getStaticPaths() {
  if (process.env.PRIVATE_BUILD !== '1') return []; // public build emits nothing here
  const files = import.meta.glob('../../content/clients/*.json', { eager: true }) as Record<string, any>;
  return Object.entries(files).map(([path, mod]) => ({
    params: { client: path.split('/').pop()!.replace('.json', '') },
    props: { data: mod.default },
  }));
}
const { client } = Astro.params;
const { data } = Astro.props;
const ev = (events as Record<string, any>)[data.event] ?? events.generic;
const evKey = (events as Record<string, any>)[data.event] ? data.event : 'generic';
---
<Base title={data.title} noindex ogImage={`/og-gallery-${evKey}.jpg`} description={ev.ogDescription}>
  <section class="mx-auto max-w-6xl px-5 pt-12 pb-8 flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="font-script text-4xl sm:text-5xl leading-none text-seaglass">{ev.heading}</p>
      <h1 class="mt-3 text-4xl sm:text-5xl">{data.title}</h1>
      {data.subtitle && <p class="mt-2 text-mist">{data.subtitle}</p>}
      <p class="mt-2 text-sm text-mist">Proof images are watermarked. Select a photo to open it full size.</p>
    </div>
    <form method="post" action={`/clients/${client}/logout`}>
      <button class="border border-line2 px-4 py-2 text-sm hover:border-paper">Log out</button>
    </form>
  </section>
  <Gallery slug={client!} images={data.images} />
  <div class="h-8"></div>
</Base>
