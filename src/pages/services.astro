---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Img from '../components/Img.astro';
import Process from '../components/Process.astro';
import CtaBand from '../components/CtaBand.astro';

const packages = [
  { id: 'weddings', type: 'Wedding', name: 'Tidewater', tag: 'Weddings & elopements', from: '$3,200', ref: 'portfolio/weddings-05', featured: true,
    blurb: 'For ceremonies on the shoreline and the long, golden evening that follows.',
    items: ['Up to 8 hours of coverage', 'Planning call and light & tide scouting', 'Engagement session at the water', '600+ finished images, colour-graded', 'Private passworded gallery with watermarked proofs', 'Print rights and a gallery that stays online for a year'] },
  { id: 'portraits', type: 'Portrait', name: 'Golden Hour', tag: 'Portraits, couples & families', from: '$450', ref: 'portfolio/portraits-06', featured: false,
    blurb: 'An easy hour at the best light of the day, somewhere that means something to you.',
    items: ['60-minute session at a coastal location', 'Location and outfit guidance', '40+ finished images', 'Private passworded gallery', 'A $50 print credit', 'Extra hours available'] },
  { id: 'landscapes', type: 'Landscape', name: 'Salt & Sand', tag: 'Landscapes & fine-art prints', from: '$85', ref: 'portfolio/landscapes-05', featured: false,
    blurb: 'Coastline prints made to hang in homes, hotels and offices, or a commission of your own.',
    items: ['Archival pigment prints, 8×10 to 40×60', 'Framing and mounting options', 'Limited editions, signed and numbered', 'Commissions for hospitality and offices', 'Delivery and installation by arrangement'] },
];
const addons = [['Second photographer', '+ $600'], ['Extra hour of coverage', '+ $250'], ['Heirloom album, 30 pages', 'from $480'], ['Rush gallery (5 days)', '+ $150']];
const faqs = [
  ['How far ahead should we book?', 'Summer and autumn weekends are usually taken 9 to 12 months out. Weekdays and winter sessions are often available within a few weeks, so ask.'],
  ['Where do you photograph?', 'Mostly the Carolina coast, from the dunes to the marsh boardwalks. We travel happily; a small fee applies beyond 60 miles.'],
  ['What happens if it rains?', 'We build a backup window into every plan. Grey skies and drizzle make wonderfully moody photographs, and we only reschedule when conditions are unsafe.'],
  ['How do private galleries work?', 'After your session you receive a private link and a password. Proofs are watermarked until you choose your favourites. You can read how it works on the <a class="underline hover:text-seaglass" href="/client-login/">client login page</a>.'],
  ['When will we see our photographs?', 'Portrait proofs arrive in about two weeks; weddings take four to six. A rush option is available.'],
  ['Can we print the photographs?', 'Yes. Print rights are included with every session, and we offer archival prints and albums if you would like them made well.'],
  ['How do we hold our date?', 'A 30% retainer secures your date and the balance is due two weeks before the session. We send a simple agreement; no surprises.'],
];
---
<Base title="Services" description="Wedding, portrait and fine-art print packages from Saltmarsh Photo Co., with sample pricing, add-ons and answers to common questions.">
  <PageHero image="site/services-hero" kicker="Packages & pricing" title="Services" subtitle="Simple, honest packages for the coast's best light. Every session ends in a private gallery of finished photographs." position="center 55%" />

  <section class="container-x pb-6">
    <p class="mb-12 max-w-2xl text-sm text-mist reveal">Sample pricing for this demo. Packages are fictional.</p>
    <div class="grid gap-6 lg:grid-cols-3">
      {packages.map((p, i) => (
        <article id={p.id} class:list={['pkg reveal', p.featured && 'featured']} style={`--d:${i * 120}ms`}>
          {p.featured && <span class="badge">Most loved</span>}
          <div class="-mx-2 -mt-2 mb-7 overflow-hidden"><Img id={p.ref} sizes="(min-width:1024px) 33vw, 100vw" class="aspect-[4/3] w-full object-cover" /></div>
          <p class="label">{p.tag}</p>
          <h2 class="mt-3 text-5xl">{p.name}</h2>
          <p class="mt-4 text-mist leading-relaxed">{p.blurb}</p>
          <p class="mt-6 font-serif text-4xl"><span class="text-base text-mist">from </span>{p.from}</p>
          <ul class="mt-4 flex-1">{p.items.map((t) => <li>{t}</li>)}</ul>
          <a class:list={['btn mt-9', p.featured ? 'btn-primary' : 'btn-ghost']} href={`/contact/?type=${p.type}`}>Enquire about {p.name} <span class="arr" aria-hidden="true">→</span></a>
        </article>
      ))}
    </div>
  </section>

  <section class="container-x grid gap-14 py-24 lg:grid-cols-[1fr_1.1fr] lg:py-32">
    <div>
      <p class="kicker reveal">Little extras</p>
      <h2 class="h-section mt-2 reveal" style="--d:80ms">Add-ons</h2>
      <p class="lead mt-5 max-w-md reveal" style="--d:160ms">Build the day you imagine. Everything is optional and can be added up to two weeks before your session.</p>
    </div>
    <ul class="divide-y divide-line border-y border-line">
      {addons.map(([n, price], i) => (
        <li class="flex items-baseline justify-between gap-6 py-5 reveal" style={`--d:${i * 80}ms`}>
          <span class="font-serif text-2xl sm:text-3xl">{n}</span>
          <span class="whitespace-nowrap text-sm tracking-[.12em] text-sun uppercase">{price}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="border-t border-line py-24 lg:py-32">
    <div class="container-x">
      <div class="mb-14 max-w-xl">
        <p class="kicker reveal">How it works</p>
        <h2 class="h-section mt-2 reveal" style="--d:80ms">From hello to heirloom</h2>
      </div>
      <Process />
    </div>
  </section>

  <section id="faq" class="border-t border-line py-24 lg:py-32">
    <div class="container-x grid gap-12 lg:grid-cols-[.8fr_1.4fr]">
      <div>
        <p class="kicker reveal">Good questions</p>
        <h2 class="h-section mt-2 reveal" style="--d:80ms">Frequently asked</h2>
        <p class="lead mt-5 max-w-sm reveal" style="--d:160ms">Not here? <a class="link-u text-paper" href="/contact/">Ask us directly.</a></p>
      </div>
      <div class="faq reveal">
        {faqs.map(([q, a], i) => (
          <details open={i === 0}><summary>{q}</summary><div set:html={a} /></details>
        ))}
      </div>
    </div>
  </section>

  <CtaBand kicker="Ready when you are" title="Let's find your light." />
</Base>
